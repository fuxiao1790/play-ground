digraph ArcaneBlastRedesign {
  graph [rankdir=LR, newrank=true, compound=true, ordering=out,
    nodesep=0.35, ranksep=1.15, splines=ortho, pad=0.2, bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10,
    color="#333333", fillcolor="#FFFFFF"];
  edge [fontname="Arial", fontsize=8, color="#333333", weight=1];

  // Lane 1: inputs
  onspawn [label="OnSpawn\nEvent/Trigger", fillcolor="#D8F5C0", color="#2E7D32"];
  positions [label="Positions\nGraphicsBuffer\ntransient", fillcolor="#BFE3FF", color="#0B5A9E"];
  areas [label="AreaSizes\nGraphicsBuffer\ntransient", fillcolor="#BFE3FF", color="#0B5A9E"];
  spawncount [label="SpawnCount\nint\ntransient", fillcolor="#BFE3FF", color="#0B5A9E"];
  base_size [label="Get Base Size\nCurrent", fillcolor="#FFE8A3", color="#8A6D00"];
  ring_curve [label="shockwave-size-over-life\nAnimationCurve", fillcolor="#FFE8A3", color="#8A6D00"];
  ring_texture [label="arcane-shockwave-ring.png\nTexture2D", fillcolor="#BFE3FF", color="#0B5A9E"];
  sparks_texture [label="arcane-spark-clusters.png\nTexture2D 2x2 atlas", fillcolor="#BFE3FF", color="#0B5A9E"];

  // Lane 2: computations
  clamp [label="Clamp (uint)\nspawnIndex, 0, SpawnCount - 1", fillcolor="#FFE8A3", color="#8A6D00"];
  samplepos [label="Sample Graphics Buffer\nPositions[index]", fillcolor="#FFE8A3", color="#8A6D00"];
  samplearea [label="Sample Graphics Buffer\nAreaSizes[index]", fillcolor="#FFE8A3", color="#8A6D00"];
  normalize [label="Multiply (float)\nAreaSizes[index] x 4.5\nNormalized Base Size", fillcolor="#FFE8A3", color="#8A6D00"];
  vector3 [label="Vector3\n(x, y, 0)", fillcolor="#FFE8A3", color="#8A6D00"];

  // Lane 3: Context systems. One cluster per editor Context.
  subgraph cluster_spawn {
    label="1. Spawn";
    color="#333333"; style="rounded";
    ctx_spawn [label="Spawn\nloopDuration = Infinite\nloopCount = Infinite"];
    block_burst [label="1. Single Burst\nspawnMode = Constant"];
    { rank=same; ctx_spawn; block_burst; }
    ctx_spawn -> block_burst [style=invis, constraint=false, weight=100];
  }

  subgraph cluster_initialize {
    label="2. Initialize Particle";
    color="#333333"; style="rounded";
    ctx_initialize [label="Initialize Particle\ncapacity = 32\nbounds = automatic"];
    init_lifetime [label="1. Set Lifetime\nComposition = Overwrite\nSource = Slot"];
    init_position [label="2. Set Position\nComposition = Overwrite\nSource = Slot"];
    init_base_size [label="3. Set Base Size\nComposition = Overwrite\nSource = Slot"];
    init_size [label="4. Set Size\nComposition = Overwrite\nSource = Slot"];
    init_angle [label="5. Set Angle.Z\nRandom Uniform"];
    init_tex_index [label="6. Set Tex Index\nRandom Uniform"];
    { rank=same; ctx_initialize; init_lifetime; init_position; init_base_size; init_size; init_angle; init_tex_index; }
    ctx_initialize -> init_lifetime -> init_position -> init_base_size -> init_size -> init_angle -> init_tex_index
      [style=invis, constraint=false, weight=100];
  }

  subgraph cluster_update {
    label="3. Update Particle";
    color="#333333"; style="rounded";
    ctx_update [label="Update Particle"];
    update_size [label="1. Set Size\nbase size x size-over-life"];
    update_color [label="2. Set Color\nOver Life"];
    update_alpha [label="3. Set Alpha\nOver Life"];
    { rank=same; ctx_update; update_size; update_color; update_alpha; }
    ctx_update -> update_size -> update_color -> update_alpha
      [style=invis, constraint=false, weight=100];
  }

  subgraph cluster_ring_output {
    label="4. Output Particle Unlit Quad (ring)";
    color="#333333"; style="rounded";
    ctx_ring_output [label="Output Particle Unlit Quad\nring material"];
    ring_orient [label="1. Orient: Face Camera Position"];
    { rank=same; ctx_ring_output; ring_orient; }
    ctx_ring_output -> ring_orient [style=invis, constraint=false, weight=100];
  }

  subgraph cluster_sparks_output {
    label="5. Output Particle Unlit Quad (sparks)";
    color="#333333"; style="rounded";
    ctx_sparks_output [label="Output Particle Unlit Quad\nsparks material"];
    sparks_orient [label="1. Orient: Face Camera Position"];
    sparks_flipbook [label="2. Flipbook\n2x2 atlas"];
    { rank=same; ctx_sparks_output; sparks_orient; sparks_flipbook; }
    ctx_sparks_output -> sparks_orient -> sparks_flipbook
      [style=invis, constraint=false, weight=100];
  }

  // Fixed vertical lane membership.
  subgraph lane_inputs {
    rank=same;
    onspawn; positions; areas; spawncount; base_size; ring_curve; ring_texture; sparks_texture;
  }
  subgraph lane_computations {
    rank=same;
    clamp; samplepos; samplearea; normalize; vector3;
  }
  subgraph lane_systems {
    rank=same;
    ctx_spawn; ctx_initialize; ctx_update; ctx_ring_output; ctx_sparks_output;
  }

  // Invisible lane guides own placement. Real edges cannot collapse lanes.
  positions -> clamp -> ctx_initialize [style=invis, weight=100, minlen=2];
  onspawn -> positions -> areas -> spawncount -> base_size -> ring_curve -> ring_texture -> sparks_texture
    [style=invis, constraint=false, weight=100];
  clamp -> samplepos -> samplearea -> normalize -> vector3
    [style=invis, constraint=false, weight=100];
  ctx_spawn -> ctx_initialize -> ctx_update -> ctx_ring_output -> ctx_sparks_output
    [style=invis, constraint=false, weight=100];

  // Context flow
  onspawn -> ctx_spawn [label="OnSpawn", color="#C0392B", penwidth=2, style=bold, weight=2, constraint=false];
  ctx_spawn -> ctx_initialize [label="particle flow", constraint=false];
  ctx_initialize -> ctx_update [label="particle flow", constraint=false];
  ctx_update -> ctx_ring_output [label="particle flow", constraint=false];
  ctx_update -> ctx_sparks_output [label="particle flow", constraint=false];

  // Input-to-computation and computation-to-Block wiring.
  spawncount -> block_burst [label="Count", constraint=false];
  spawncount -> clamp [label="max = SpawnCount - 1", constraint=false];
  positions -> samplepos [label="buffer", constraint=false];
  areas -> samplearea [label="buffer", constraint=false];
  clamp -> samplepos [label="index", constraint=false];
  clamp -> samplearea [label="index", constraint=false];
  samplepos -> vector3 [label="x, y", constraint=false];
  vector3 -> init_position [label="Position", constraint=false];
  samplearea -> normalize [label="raw area size", constraint=false];
  normalize -> init_base_size [label="Base Size", constraint=false];
  normalize -> init_size [label="Size", constraint=false];
  base_size -> update_size [label="base size", constraint=false];
  ring_curve -> update_size [label="multiplier", constraint=false];
  ring_texture -> ctx_ring_output [label="mainTexture", constraint=false];
  sparks_texture -> ctx_sparks_output [label="mainTexture", constraint=false];
}
