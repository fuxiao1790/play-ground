/*
 * SkillLoadoutUi styling.
 * Skill-loadout rules are a 1:1 transcription of inline styles previously set
 * in SkillLoadoutUi.cs. PerformanceUi has its own HUD-card styling below.
 *
 * Color conversion (Unity Color 0-1 floats -> USS rgba 0-255 channels, 0-1 alpha):
 *   bar   Color(0.03, 0.04, 0.08, 0.88) -> rgba(8, 10, 20, 0.88)
 *   modal Color(0.04, 0.05, 0.10, 0.96) -> rgba(10, 13, 26, 0.96)
 */

/* Root layer stack (back-to-front, authored in SkillLoadoutUi.uxml document order):
   #click-to-fire-layer, #hud-container, #popup-layer, #pause-background,
   #pause-menu-layer. Every layer fills the panel; later siblings draw over
   earlier siblings. Picking mode is authored per layer and set explicitly on
   any descendant that must stay pass-through, since PickingMode.Ignore does
   not propagate to children. World-projected labels live in a separate
   lower-sorted WorldLabelsPanel (see WorldLabelsUi.uxml/.uss), not in this
   document. */
.ui-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* HUD structure */
.hud-container {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    padding-right: 12%;
    padding-left: 12%;
}

/* PerformanceUi */
.performance-panel {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 280px;
    padding: 6px 8px;
    background-color: rgba(9, 12, 22, 0.72);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(134, 160, 210, 0.3);
    border-right-color: rgba(134, 160, 210, 0.3);
    border-bottom-color: rgba(134, 160, 210, 0.3);
    border-left-color: rgba(134, 160, 210, 0.3);
}

.performance-text {
    color: white;
    font-size: 14px;
    white-space: normal;
}

/* Show more / less toggle. The panel itself is picking-ignore so the world stays
   clickable through it; PickingMode.Ignore does not propagate, so this button
   still takes clicks. */
.performance-toggle {
    align-self: flex-end;
    height: 20px;
    margin: 4px 0 0 0;
    padding: 0 8px;
    font-size: 11px;
}

/* Reserved for the future target-health projection. */
.target-hud {
    align-self: center;
    width: 680px;
    height: 80px;
    margin-top: 20px;
}

.bottom-hud {
    margin-top: auto;
    min-height: 128px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 16px;
}

.hud-resource-slot {
    width: 104px;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

/* BuildBar() */
.skill-bar {
    flex-direction: row;
    align-items: flex-end;
    background-color: rgba(8, 10, 20, 0.88);
    padding: 10px 12px;
}

/* AddNodeColumn() column */
.node-column {
    flex-direction: column;
    align-items: center;
}

/* AddNodeColumn() supports row */
.support-row {
    flex-direction: row;
}

/* AddNodeColumn() decrease / increase support-cap buttons */
.cap-button {
    width: 28px;
    height: 28px;
}

/* AddNodeColumn() support slot buttons */
.support-button {
    width: 34px;
    height: 28px;
    font-size: 10px;
}

/* AddNodeColumn() skill button */
.skill-button {
    width: 112px;
    height: 70px;
    white-space: normal;
}

/* AddNodeColumn(): applied when the node has an incoming trigger (was style.opacity = 0.45f) */
.skill-button--triggered {
    opacity: 0.45;
}

/* AddNodeColumn() per-node cooldown label */
.cooldown-label {
    position: absolute;
    right: 8px;
    bottom: 4px;
    color: white;
}

/* AddTriggerButton() */
.trigger-button {
    width: 112px;
    height: 38px;
    margin-bottom: 15px;
    white-space: normal;
    font-size: 10px;
}

/* Utility: caps are absent when a node has no skill set (was: buttons not created). */
.hidden {
    display: none;
}

/* OpenPicker() modal */
.picker-modal {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 560px;
    background-color: rgba(10, 13, 26, 0.96);
    padding: 12px 16px;
}

/* OpenPicker() choices container */
.picker-choices {
    flex-direction: row;
    flex-wrap: wrap;
}

/* AddChoice() choice buttons */
.picker-choice {
    margin-right: 6px;
    margin-bottom: 6px;
}

/* #pause-background: visual dimmer + input shield while paused. C# toggles
   between these two classes and the element's PickingMode; USS only controls
   visibility. */
.pause-background {
    background-color: rgba(0, 0, 0, 0.55);
}

.pause-background--hidden {
    display: none;
}

.pause-background--visible {
    display: flex;
}
