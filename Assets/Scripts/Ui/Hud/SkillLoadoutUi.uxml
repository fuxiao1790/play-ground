<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="SkillLoadoutUi.uss" />
    <Style src="ResourceBarUi.uss" />
    <ui:VisualElement name="click-to-fire-layer" class="ui-layer" picking-mode="Position" />
    <ui:VisualElement name="hud-container" class="ui-layer hud-container">
        <ui:VisualElement name="performance-panel" class="performance-panel">
            <ui:Label name="performance-fps" class="performance-text" />
            <!-- Everything below the FPS line collapses behind #performance-toggle. -->
            <ui:VisualElement name="performance-details">
                <ui:Label name="performance-spawn-reuse" class="performance-text" />
                <ui:Label name="performance-create-ecb" class="performance-text" />
                <ui:Label name="performance-despawned" class="performance-text" />
                <ui:Label name="performance-delete-ecb" class="performance-text" />
                <ui:Label name="performance-projectiles" class="performance-text" />
                <ui:Label name="performance-aoes" class="performance-text" />
                <ui:Label name="performance-targeted" class="performance-text" />
                <ui:Label name="performance-projectile-template-registry" class="performance-text" />
                <ui:Label name="performance-aoe-template-registry" class="performance-text" />
                <ui:Label name="performance-targeted-template-registry" class="performance-text" />
                <ui:Label name="performance-hit-events" class="performance-text" />
                <ui:Label name="performance-vfx-events" class="performance-text" />
                <ui:Label name="performance-sound-events" class="performance-text" />
                <ui:Label name="performance-vfx-particles" class="performance-text" />
            </ui:VisualElement>
            <ui:Button name="performance-toggle" class="performance-toggle" text="Show less" />
        </ui:VisualElement>
        <!-- Reserved for a future target-health projection. -->
        <ui:VisualElement name="target-hud" class="target-hud" />
        <ui:VisualElement name="bottom-hud" class="bottom-hud">
            <ui:VisualElement name="health-resource-slot" class="hud-resource-slot">
                <ui:Label name="health-title" class="resource-orb__title" />
                <ui:VisualElement name="health-bar" class="resource-orb resource-orb--health">
                    <ui:VisualElement name="health-fill" class="resource-orb__fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- C# fills #bar with cloned node columns and trigger buttons so the count
                 stays driven by initialNodeCount. -->
            <ui:VisualElement name="bar" class="skill-bar" />
            <ui:VisualElement name="mana-resource-slot" class="hud-resource-slot">
                <ui:Label name="mana-title" class="resource-orb__title" />
                <ui:VisualElement name="mana-bar" class="resource-orb resource-orb--mana">
                    <ui:VisualElement name="mana-fill" class="resource-orb__fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="popup-layer" class="ui-layer" picking-mode="Ignore" />
    <ui:VisualElement name="pause-background" class="ui-layer pause-background pause-background--hidden" picking-mode="Ignore" />
    <ui:VisualElement name="pause-menu-layer" class="ui-layer" picking-mode="Ignore" />
</ui:UXML>
